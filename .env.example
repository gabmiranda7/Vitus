# Banco de dados
DB_USER=postgres
DB_PASS=troque-esta-senha

# Autenticação (JWT) - use uma chave longa e aleatória
JWT_KEY=troque-por-uma-chave-secreta-longa

# Criptografia AES das anotações e observações de triagem
# ATENÇÃO: guarde uma cópia segura. Sem esta chave, os dados criptografados ficam ilegíveis
ENCRYPTION_KEY=troque-por-outra-chave-secreta-longa

# Análise de exames por IA (Gemini). Opcional: sem ela, o botão de análise retorna erro
GEMINI_API_KEY=

# Deixe vazio: o nginx do frontend encaminha /api para a API
VITE_API_URL=

# Em desenvolvimento, use 0.0.0.0 para acessar de outro dispositivo (ex.: celular na mesma rede)
# BIND_ADDRESS=0.0.0.0